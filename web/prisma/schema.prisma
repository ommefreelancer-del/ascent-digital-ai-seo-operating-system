// ADASOS web (v2.0) data model.
//
// This is new, additive persistence for the frontend layer only (accounts,
// projects, saved API results) -- it never touches the frozen backend's own
// audit-log / task-state files under ../var, and the backend package itself
// is never modified.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  companyName   String?
  jobTitle      String?
  role          String    @default("owner")
  theme         String    @default("system")
  emailNotifications Boolean @default(true)
  productUpdates     Boolean @default(true)
  weeklyDigest       Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects       Project[]
  apiKeys        ApiKey[]
  resetTokens    PasswordResetToken[]
  savedKeywords  SavedKeyword[]
  chatSessions   ChatSession[]
  reports        Report[]
  seoAudits      SeoAudit[]
  contentDrafts  ContentDraft[]
  activities     ActivityEvent[]
  googleSearchConsoleConnection GoogleSearchConsoleConnection?
  googleServiceConnections GoogleServiceConnection[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Project {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  niche     String?
  status    String   @default("active") // active | paused | completed
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ProjectActivity[]
  audits     SeoAudit[]
  reports    Report[]

  @@index([ownerId, status])
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model SeoAudit {
  id            String   @id @default(cuid())
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  resultJson    String
  criticalCount Int
  warningCount  Int
  infoCount     Int
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId])
}

model SavedKeyword {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword       String
  intent        String
  intentRationale String
  createdAt     DateTime @default(now())

  @@unique([userId, keyword])
  @@index([userId, createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  keyPrefix  String
  keyHash    String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // user | assistant
  content   String
  agentId   String?
  status    String?  // assigned | escalated | rejected
  metaJson  String?  // JSON: { routingDecision, escalations } for assistant messages, for the Task Progress / Execution Log detail view
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model Report {
  id         String   @id @default(cuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  type       String   // seo-performance | ai-usage | keyword-growth
  resultJson String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model ContentDraft {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // blog | landing-page | meta | social
  title      String
  resultJson String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  message   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A per-user connection to the user's own Google Search Console data,
// distinct from app login (which stays email/password via CredentialsProvider
// in server/auth.ts). Populated by the OAuth flow under
// api/integrations/google-search-console/*, never by next-auth itself --
// there's no NextAuth Adapter/Account table in this schema, so a next-auth
// GoogleProvider would have nowhere valid to attach a session's identity.
model GoogleSearchConsoleConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken     String
  refreshToken    String
  scope           String
  expiresAt       DateTime
  // Which of the account's sites.list properties to query for this user.
  // Was never persisted anywhere before -- listSites() can return several
  // properties (most Wix-auto-registered and unverified), and nothing chose
  // one for Search Analytics calls to actually target. Auto-picked (first
  // verified property) the first time it's needed and cached here; null
  // means "not yet resolved" or "no verified property exists yet", not
  // "unset by mistake" -- see server/google-search-console.ts's
  // getOrSelectPrimarySite().
  selectedSiteUrl String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Generic foundation for Google service connections beyond Search Console
// (Business Profile, Sheets, Gmail, etc. -- Phase 2). Deliberately separate
// from GoogleSearchConsoleConnection rather than extending it: that model's
// `userId @unique` is a hard one-to-one constraint that can't hold more than
// one row per user, and its `selectedSiteUrl` field has no equivalent
// meaning for non-Search-Console services. This model is not yet used by
// any code -- no service is wired to it in this change; it exists purely as
// the shared data-model foundation for the Google integrations that follow.
model GoogleServiceConnection {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "business_profile" | "sheets" | "gmail", etc. -- one row per
  // (user, service) pair, enforced below, so a user can hold independent
  // connections to multiple Google services at once.
  service      String
  accessToken  String
  refreshToken String
  scope        String
  expiresAt    DateTime
  // Service-specific selected-resource state (e.g. a chosen Business
  // Profile location id, a chosen spreadsheet id), JSON-encoded as a string
  // -- matching this schema's existing convention (SeoAudit.resultJson,
  // Report.resultJson, ChatMessage.metaJson) rather than Prisma's native
  // Json type. Deliberately a single field rather than one nullable column
  // per service -- a per-service column set would grow with every new
  // service added and leave most rows mostly null; the shape for a given
  // `service` value is validated in application code, not by the database.
  metadataJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, service])
}
