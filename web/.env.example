# Copy to .env (or .env.local) and fill in real values before running.

# SQLite by default -- swap for a real Postgres/MySQL connection string in production.
DATABASE_URL="file:./prisma/dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Required for the AI Workspace to generate a specialist agent's actual reply
# (after the Boss Agent routes the task). Get a key from
# https://console.anthropic.com/settings/keys -- without it, the AI Workspace
# still routes tasks correctly but cannot generate a final AI response.
ANTHROPIC_API_KEY="replace-with-your-anthropic-api-key"

# Optional -- defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL="claude-sonnet-5"

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID (download the JSON, copy client_id/client_secret from it -- do
# not commit or place the JSON file itself anywhere in this repo).
# Authorized redirect URI must be http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="replace-with-your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-oauth-client-secret"

# Google Analytics 4 measurement ID, from Admin -> Data Streams -> your web
# stream, in Analytics. Public identifier, safe to expose client-side --
# must be prefixed NEXT_PUBLIC_ so Next.js inlines it into the browser
# bundle. Leave unset to disable analytics entirely (no script loads, no
# tracking calls fire) -- there is no mock/fallback tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID="replace-with-your-ga4-measurement-id"

# Required for the Graphic Design Agent's Pixabay image/video search (royalty-
# free stock assets). Get a free key from https://pixabay.com/api/docs/ (sign
# up, then find it under Account -> API). Server-only -- deliberately NOT
# prefixed NEXT_PUBLIC_, so it is never inlined into the browser bundle.
# Without it, /api/assets/pixabay/* routes return a clear "not configured"
# error instead of calling Pixabay.
PIXABAY_API_KEY="replace-with-your-pixabay-api-key"

# Required for the "Connect with WordPress.com" one-click option (Website
# Management Agent's WordPress integration). Register a free application at
# https://developer.wordpress.com/apps/ -- a WordPress.com account is enough,
# no site/domain/Jetpack required. Set its redirect URI to exactly
# http://localhost:3000/api/integrations/wordpress/wpcom/callback, then copy
# the Client ID/Client Secret it gives you. Server-only -- deliberately NOT
# prefixed NEXT_PUBLIC_. Without these, the WordPress.com button shows a
# clear "not configured" message; the self-hosted Application Passwords
# connection option (no client id/secret needed) still works either way.
WPCOM_CLIENT_ID="replace-with-your-wordpress-com-client-id"
WPCOM_CLIENT_SECRET="replace-with-your-wordpress-com-client-secret"
