#!/usr/bin/env bash
# Blocks a commit if the working tree has untracked files that aren't
# gitignored. This exists because most of web/ (the whole Next.js app: src/,
# tests/, prisma/schema.prisma, configs) was silently never committed for
# weeks -- new files kept getting created without a matching `git add`, and
# nothing ever flagged it. See RUN_GUIDE.md for the full investigation.
#
# This does not run automatically on a fresh clone -- git doesn't track
# hook wiring itself. Each clone needs to opt in once:
#   git config core.hooksPath .githooks
set -euo pipefail

# SCOPE FIX (2026-09-09): the failure mode this hook exists to catch is
# specifically a NEW file being created and never `git add`-ed -- the
# original incident was whole new files (API routes, server modules, tests)
# silently never entering the index at all. A commit that only contains
# MODIFICATIONS to already-tracked files structurally cannot exhibit that
# failure mode: there's no new file in this commit that could have been
# forgotten. Gating the untracked-file scan on "this commit actually adds at
# least one new file" keeps the check exact for the scenario it was built
# for, instead of firing on every commit regardless of what it contains --
# which previously made it impossible to land a narrow, deliberate,
# modifications-only commit in a working tree that also happens to have
# unrelated in-progress work sitting around untracked elsewhere.
staged_additions=$(git diff --cached --name-only --diff-filter=A || true)

if [ -z "$staged_additions" ]; then
  exit 0
fi

# BASELINE FIX (2026-09-10): a commit that DOES add new file(s) still needs
# this check -- that's the actual incident, a real new file never added --
# but this repo genuinely carries a large amount of separate, long-running,
# untracked work-in-progress at any given time, and blocking every new-file
# commit until ALL of that unrelated work is either added or gitignored made
# it impossible to land a small, deliberate, already-reviewed new-file
# commit (e.g. a new lib file plus its own test) without touching work that
# belongs to a different, in-progress task. .githooks/known-untracked.txt is
# a versioned, reviewable snapshot of untracked paths already known about
# and deliberately left out -- ONLY an untracked file NOT already on that
# list (i.e. something that just appeared, unaccounted for) still blocks
# the commit, which is exactly the "forgot to add a new file" signal this
# hook exists to catch. See that file's own header for how to update it.
untracked_raw=$(git status --porcelain --untracked-files=all | grep '^??' | awk '{print $2}' || true)

if [ -z "$untracked_raw" ]; then
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
baseline_file="$repo_root/.githooks/known-untracked.txt"

untracked=$(printf '%s\n' "$untracked_raw" | LC_ALL=C sort)

if [ -f "$baseline_file" ]; then
  known=$(grep -v '^#' "$baseline_file" | grep -v '^[[:space:]]*$' | LC_ALL=C sort || true)
  unexpected=$(comm -23 <(printf '%s\n' "$untracked") <(printf '%s\n' "$known") || true)
else
  unexpected="$untracked"
fi

if [ -n "$unexpected" ]; then
  echo "pre-commit: refusing to commit -- this commit adds new file(s), and untracked file(s) exist that aren't on the known-untracked baseline:" >&2
  echo "$unexpected" | sed 's/^/  /' >&2
  echo >&2
  echo "Either 'git add' them (they're production files that belong in this commit)," >&2
  echo "add a pattern for them to the nearest .gitignore (they're generated/local)," >&2
  echo "or, if they're deliberate pre-existing unrelated work you're intentionally" >&2
  echo "leaving untracked, add them to .githooks/known-untracked.txt." >&2
  echo "This check exists so new files never again silently go untracked -- see RUN_GUIDE.md." >&2
  exit 1
fi
